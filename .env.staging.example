# Public browser configuration only. Copy to .env.staging locally; never add secrets.
VITE_API_URL=https://staging-api.example.invalid/api
VITE_FIREBASE_API_KEY=replace-public-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-staging-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-staging-project
VITE_FIREBASE_APP_ID=replace-public-web-app-id
VITE_TELEMETRY_ENABLED=false
