NODE_ENV=production
APP_ENV=staging
PORT=5000
API_BIND_HOST=0.0.0.0
MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST/lugaish_staging
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
FIREBASE_PROJECT_ID=REPLACE_WITH_SEPARATE_STAGING_PROJECT
FRONTEND_URL=https://staging.example.invalid
CORS_ORIGIN=https://staging.example.invalid
# Set only to the actual trusted proxy address/CIDR supplied by your host.
TRUST_PROXY=
RELEASE_ID=replace-immutable-git-commit
# Firebase Admin uses application default credentials supplied securely by the host.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
TELEMETRY_ENABLED=false

# Used by paired release validation, not an application credential.
PUBLIC_API_ORIGIN=https://REPLACE_APPROVED_API_HOST
