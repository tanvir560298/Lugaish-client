# PRIVATE HOST CONFIG TEMPLATE — intentionally invalid until owner supplies values.
# Never place this file's configured values in VITE_* variables or Git.
NODE_ENV=production
APP_ENV=production
PORT=5000
API_BIND_HOST=0.0.0.0
MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER/lugaish_production
JWT_SECRET=REPLACE_WITH_SEPARATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
FIREBASE_PROJECT_ID=REPLACE_APPROVED_PRODUCTION_PROJECT
FRONTEND_URL=https://REPLACE_APPROVED_FRONTEND_HOST
CORS_ORIGIN=https://REPLACE_APPROVED_FRONTEND_HOST
# Exact trusted upstream IP/CIDR only; leave unset until topology is verified.
TRUST_PROXY=
# Private host-mounted application-default credentials, never an artifact asset.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json
RELEASE_ID=REPLACE_MATCHING_REVIEWED_RELEASE
TELEMETRY_ENABLED=false

# Used by paired release validation, not an application credential.
PUBLIC_API_ORIGIN=https://REPLACE_APPROVED_API_HOST
